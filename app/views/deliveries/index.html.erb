<div>
  <div>
    <h1>
      Delivery Tracker
    </h1>
    <p>Know if something gets lost in the mail.</p>
  </div>
</div>

<hr>

<div>
  <div>
    <h2>
      Expecting a package?
    </h2>

    <form action="/insert_delivery" method="post">
      <div>
        <label for="description_box">
          Description
        </label>

        <input type="text" id="description_box" name="query_description">
      </div>

      <div>
        <label for="supposed_to_arrive_on_box">
          Supposed to arrive on
        </label>

        <input type="date" id="supposed_to_arrive_on_box" name="query_supposed_to_arrive_on">
      </div>

      <div>
        <label for="details_box">
          Details
        </label>

        <textarea id="details_box" name="query_details" rows="3"></textarea>
      </div>

      <button type="submit">
        Log delivery
      </button>
    </form>
  </div>
</div>

<hr>

<% list_of_packages = current_user.deliveries.where(arrived: false).order({:supposed_to_arrive_on => :asc}) %>

<div class="waiting_on" style="background-color: lightyellow;">
  <h2>Waiting on</h2>
  <ul>
    <% list_of_packages.each do |package| %>
      <li>
        <div><%= package.description %></div>
        <div><%= package.details %></div>
        <div style="<%= 'color: red;' if package.supposed_to_arrive_on + 3 < Date.today %>">Supposed to arrive on <%= package.supposed_to_arrive_on %></div>
        <div>
          <form action="/modify_delivery/<%= package.id %>" method="post">
            <input type="hidden" name="query_arrived" value="true">

            <button>Mark as received</button>
          </form>
        </div>
      </li>
    <% end %>
  </ul>
</div>

<hr>

<div class="received" style="background-color: green">
  <h2>Received</h2>
  <% delivered = current_user.deliveries.where(arrived: true).order(updated_at: :desc) %>
  <ul>
    <% delivered.each do |package| %>
      <li>
        <div><%= package.description %></div>
        <div>
          <small>
            Updated <%= time_ago_in_words(package.updated_at) %> ago
            <a href="/delete_delivery/<%= package.id %>">Delete</a>
          </small>
        </div>
      </li>
    <% end %>
  </ul>
</div>
